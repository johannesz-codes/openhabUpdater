# Copy this file to .env and fill in your values.
# Keep .env out of version control!

# ── Telegram notifications ────────────────────────────────────────────────────
# Create a bot via @BotFather and obtain its token.
bot_token=your_bot_token_here
# The numeric chat / group ID that should receive alerts.
chat_id=your_chat_id_here

# ── OpenHAB network ───────────────────────────────────────────────────────────
# IP address assigned to the OpenHAB macvlan interface.
OPENHAB_IP=192.168.11.10
# HTTP and HTTPS ports exposed by the OpenHAB container.
OPENHAB_HTTP_PORT=8080
OPENHAB_HTTPS_PORT=8443

# ── Container / volume paths ──────────────────────────────────────────────────
# Absolute path to the directory that holds the general/ folder with this script.
WORK_DIR=/volume1/docker/openhab/general
# Absolute path prefix for the per-container data directories (hera / zeus).
OH_DATA_ROOT=/volume1/docker/openhab

# ── Container runtime identity ────────────────────────────────────────────────
OH_USER_ID=9999
OH_GROUP_ID=999

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Europe/Berlin
